# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Para desarrollo local con `npx supabase start`
# usa la URL y la anon key que imprime ese comando.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key

# OJO: la service_role key NUNCA va aquí ni en el frontend.
